@import "lib/deuceline-tokens.wxss";

/* ---------------------------------------------------------------------------
   Deuceline mini program — base layer.

   lib/deuceline-tokens.wxss is GENERATED by `npm run build:core` from
   src/styles/skins.css, and owns all chrome colour (re-scoped to `page`).

   Shared colors come from the generated Wimbledon skin tokens. This native shell
   uses the same translucent material and serif chapter language as the web.

   Player identity colours are deliberately absent from this file: read them from
   the dataset (players.alan.color / players.opponent.color).
--------------------------------------------------------------------------- */

page {
  /* Small native layout tokens; color and material stay owned by skins.css. */
  --radius-lg: 22px;
  --radius-md: 14px;
  --shell-pad: 32rpx;
  --bottom-chrome-clearance: 168rpx;

  background: var(--base);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* Serif type gives chapter titles and scorelines their editorial voice. */
.serif {
  font-family: Baskerville, Georgia, "Times New Roman", serif;
  font-variant-numeric: tabular-nums;
}

.screen {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--base);
}

/* ── Content ──────────────────────────────────────────────────────────────── */
.paper {
  flex: 1;
  padding: 32rpx var(--shell-pad) calc(var(--bottom-chrome-clearance) + env(safe-area-inset-bottom));
}

/* ── Glass (system chrome and compact badges) ─────────────────────────────── */
.glass {
  background: var(--sheet);
  border: 1px solid var(--rim);
}

@supports (backdrop-filter: blur(22px)) {
  .glass {
    background: var(--glass);
    backdrop-filter: blur(22px) saturate(1.7);
  }
}

/* ── Shared states: the app never silently renders partial data ───────────── */
.state {
  padding: 56rpx 0;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.state-detail {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.issues {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--content);
  text-align: left;
}

.issues-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--muted);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ── Buttons ──────────────────────────────────────────────────────────────── */
.btn {
  display: inline-block;
  padding: 18rpx 32rpx;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--content);
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

.btn-accent {
  border-color: transparent;
  background: var(--court);
  color: var(--on-accent);
  font-weight: 600;
}
