@import "lib/deuceline-tokens.wxss";

/* ---------------------------------------------------------------------------
   Deuceline mini program — base layer.

   lib/deuceline-tokens.wxss is GENERATED by `npm run build:core` from
   src/styles/skins.css, and owns all chrome colour (re-scoped to `page`).

   The structural tokens and the journal materials below are NOT skin tokens on
   the web — they are hard-coded in src/styles/global.css — so they are mirrored
   here by hand. See MINIPROGRAM.md → "Design essence".

   Player identity colours are deliberately absent from this file: read them from
   the dataset (players.alan.color / players.opponent.color).
--------------------------------------------------------------------------- */

page {
  /* Structural tokens, mirroring src/styles/global.css `:root`. */
  --radius-lg: 22px;
  --radius-md: 14px;
  --shell-pad: 32rpx;
  --bottom-chrome-clearance: 168rpx;

  /* Journal materials: the leather band, warm paper and rule weights. The web
     keeps these hard-coded in global.css, so they are copied, not imported. */
  --leather-top: #062d20;
  --leather-bottom: #0b563e;
  --leather-gold: #e3be62;
  --paper-warm: #f7f3e8;
  --rule-strong: rgba(33, 41, 36, 0.55);

  background: var(--journal-paper);
  color: var(--journal-ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* The journal voice: huge numerals, chapter titles and the cover title. iOS ships
   Baskerville/Georgia; Android falls back to the system serif. */
.serif {
  font-family: Baskerville, Georgia, "Times New Roman", serif;
  font-variant-numeric: tabular-nums;
}

.screen {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--journal-paper);
}

/* The leather cover is a component of its own (components/journal-cover), so its
   band geometry stays next to the markup that uses it. */

/* ── Paper (every piece of content) ───────────────────────────────────────── */
.paper {
  flex: 1;
  padding: 32rpx var(--shell-pad) calc(var(--bottom-chrome-clearance) + env(safe-area-inset-bottom));
}

/* ── Glass (system chrome only — never on content, never on glass) ────────── */
.glass {
  background: var(--material-bg);
  backdrop-filter: blur(22px) saturate(1.7);
}

/* ── Shared states: the app never silently renders partial data ───────────── */
.state {
  padding: 56rpx 0;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
}

.state-detail {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.issues {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1px solid var(--journal-rule);
  border-radius: var(--radius-md);
  background: var(--paper-warm);
  text-align: left;
}

.issues-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--muted);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ── Buttons ──────────────────────────────────────────────────────────────── */
.btn {
  display: inline-block;
  padding: 18rpx 32rpx;
  border: 1px solid var(--journal-rule);
  border-radius: var(--radius-md);
  background: var(--paper-warm);
  color: var(--journal-ink);
  font-size: 26rpx;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

.btn-accent {
  border-color: transparent;
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 600;
}
