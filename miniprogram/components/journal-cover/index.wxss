/* Quiet editorial masthead; the badge is the only glass element in this header. */

.cover-wrap {
  flex: none;
  padding-left: var(--shell-pad);
  padding-right: var(--shell-pad);
  background: var(--base);
}

.cover {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 18rpx 0 22rpx;
  border-bottom: 1px solid var(--line);
}

.cover-title {
  flex: 1;
  min-width: 0;
}

.cover-title-kicker {
  margin-bottom: 7rpx;
  color: var(--muted);
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  line-height: 1.2;
}

.cover-title-main {
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: -0.015em;
  font-family: Georgia, "Times New Roman", serif;
}

.badge {
  background: var(--sheet);
  border: 1px solid var(--rim);
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  min-height: 48rpx;
  padding: 0 14rpx;
  border-radius: 24rpx;
  color: var(--ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
}

/* Matches' badge carries the chapter count instead of the version. */
.badge-count {
  min-width: 100rpx;
  min-height: 62rpx;
  padding: 6rpx 14rpx;
  flex-direction: column;
  line-height: 1;
}

.badge-strong {
  font-size: 26rpx;
}

.badge-small {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

/* Component style isolation keeps app.wxss utilities out; own the badge material here. */
@supports (backdrop-filter: blur(18px)) {
  .badge { background: var(--glass); backdrop-filter: blur(18px) saturate(135%); }
}
